{
  "name": "dsh-mcp-doctor",
  "version": "0.1.0",
  "description": "Static validation of a local MCP JSON config for DeepSeek Harness: command/url presence, command availability, URL syntax, args/env types. No server start or network.",
  "type": "module",
  "bin": { "dsh-mcp-doctor": "bin/dsh-mcp-doctor.mjs" },
  "exports": { ".": "./plugin/index.js", "./doctor": "./src/doctor.mjs", "./plugin": "./plugin/index.js", "./icon": "./icon.svg" },
  "files": ["bin", "src", "plugin", "skills", "icon.svg", "README.md", "NOTICE.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./plugin/cordis.patch.yml" } },
  "engines": { "node": ">=20" },
  "keywords": ["dsh", "deepseek-harness", "mcp", "doctor", "config", "validation"],
  "license": "MIT",
  "scripts": { "test": "node --test test/*.test.mjs" },
  "repository": { "type": "git", "url": "https://github.com/lengrufeng2008/dsh-mcp-doctor" }
}
